# HEART Backend Environment Configuration
# For local development and GCP deployment

# Google AI API Key
GOOGLE_API_KEY=your_google_ai_api_key_here

# GCP Project ID
GCP_PROJECT_ID=your_gcp_project_id

# Path to service account JSON (for Firestore Admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=./key.json

# Region for Cloud Run deployment
GCP_REGION=asia-southeast1

# Vertex AI Search
VERTEX_SEARCH_ENGINE_ID=your_vertex_search_engine_id
VERTEX_SEARCH_DATASTORE_ID=your_vertex_search_datastore_id
VERTEX_SEARCH_LOCATION=global

# Server port
PORT=3000

# Environment
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# Feature Flags
USE_FIRESTORE=true
USE_VERTEX_SEARCH=true
ENABLE_NOTIFICATIONS=false

# Google Maps API Key (Server-side)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
